    --
    +{static} createCustomer(name, email)
    +updateProfile(name, email, kycStatus)
  }
  class CustomerId <<ValueObject>> {
    +value: UUID
  }
  enum KycStatus <<Enum>> {
    PENDING
    VERIFIED
    REJECTED
